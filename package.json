{
  "name": "budget-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "test": "tsx --test src/lib/lib.test.ts src/lib/phase2.test.ts src/lib/planner.test.ts src/lib/affordability.test.ts src/lib/ai.test.ts src/lib/mcp-token.test.ts src/lib/offline-queue.test.ts src/lib/reminders.test.ts",
    "check:capture": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-capture.ts",
    "check:commitments": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-commitments.ts",
    "check:planner": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-planner.ts",
    "check:wishlist": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-wishlist.ts",
    "check:ai": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-ai.ts",
    "check:mcp": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-mcp.ts",
    "check:polish": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-polish.ts",
    "check:admin": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.128",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.183",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.2",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
